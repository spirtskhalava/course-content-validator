# Drop this into a course repository to block merges with broken content.
name: Validate course content
on: [pull_request]
jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - run: pip install git+https://github.com/spirtskhalava/course-content-validator
      - run: ccv . --format github --check-links
